// Generated by matugen — overrides the "dots" fallback theme in config.kdl
themes {
    dots {
        text_unselected   { base "{{colors.on_surface.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        text_selected     { base "{{colors.on_surface.default.hex}}"; background "{{colors.surface_container_high.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        ribbon_selected   { base "{{colors.on_primary.default.hex}}"; background "{{colors.primary.default.hex}}"; emphasis_0 "{{colors.red.default.hex}}"; emphasis_1 "{{colors.tertiary.default.hex}}"; emphasis_2 "{{colors.magenta.default.hex}}"; emphasis_3 "{{colors.blue.default.hex}}"; }
        ribbon_unselected { base "{{colors.on_surface_variant.default.hex}}"; background "{{colors.surface_container_high.default.hex}}"; emphasis_0 "{{colors.red.default.hex}}"; emphasis_1 "{{colors.on_surface.default.hex}}"; emphasis_2 "{{colors.blue.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        table_title           { base "{{colors.primary.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        table_cell_selected   { base "{{colors.on_surface.default.hex}}"; background "{{colors.surface_container_high.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        table_cell_unselected { base "{{colors.on_surface_variant.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        list_selected   { base "{{colors.on_surface.default.hex}}"; background "{{colors.surface_container_high.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        list_unselected { base "{{colors.on_surface_variant.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.green.default.hex}}"; emphasis_3 "{{colors.magenta.default.hex}}"; }
        frame_selected   { base "{{colors.primary.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.magenta.default.hex}}"; emphasis_3 "{{colors.blue.default.hex}}"; }
        frame_unselected { base "{{colors.outline_variant.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.tertiary.default.hex}}"; emphasis_1 "{{colors.cyan.default.hex}}"; emphasis_2 "{{colors.magenta.default.hex}}"; emphasis_3 "{{colors.blue.default.hex}}"; }
        frame_highlight  { base "{{colors.tertiary.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.red.default.hex}}"; emphasis_1 "{{colors.tertiary.default.hex}}"; emphasis_2 "{{colors.tertiary.default.hex}}"; emphasis_3 "{{colors.tertiary.default.hex}}"; }
        exit_code_success { base "{{colors.green.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.cyan.default.hex}}"; emphasis_1 "{{colors.on_surface.default.hex}}"; emphasis_2 "{{colors.magenta.default.hex}}"; emphasis_3 "{{colors.blue.default.hex}}"; }
        exit_code_error   { base "{{colors.red.default.hex}}"; background "{{colors.surface.default.hex}}"; emphasis_0 "{{colors.primary.default.hex}}"; emphasis_1 "{{colors.on_surface.default.hex}}"; emphasis_2 "{{colors.magenta.default.hex}}"; emphasis_3 "{{colors.blue.default.hex}}"; }
        multiplayer_user_colors {
            player_1 "{{colors.magenta.default.hex}}"; player_2 "{{colors.blue.default.hex}}"; player_3 "{{colors.tertiary.default.hex}}"; player_4 "{{colors.primary.default.hex}}"; player_5 "{{colors.cyan.default.hex}}"
            player_6 "{{colors.red.default.hex}}"; player_7 "{{colors.green.default.hex}}"; player_8 "{{colors.on_surface_variant.default.hex}}"; player_9 "{{colors.secondary.default.hex}}"; player_10 "{{colors.tertiary_container.default.hex}}"
        }
    }
}
