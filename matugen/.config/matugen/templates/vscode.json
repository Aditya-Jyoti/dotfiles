{
  "workbench.colorCustomizations": {
    "terminal.background": "{{ colors.surface.default.hex }}",
    "terminal.foreground": "{{ colors.on_surface.default.hex }}",

    "terminal.ansiBlack": "{{ colors.surface_dim.default.hex }}",
    "terminal.ansiRed": "{{ colors.error.default.hex }}",
    "terminal.ansiGreen": "{{ colors.primary.default.hex }}",
    "terminal.ansiYellow": "{{ colors.secondary.default.hex }}",
    "terminal.ansiBlue": "{{ colors.tertiary.default.hex }}",
    "terminal.ansiMagenta": "{{ colors.primary_container.default.hex }}",
    "terminal.ansiCyan": "{{ colors.tertiary_container.default.hex }}",
    "terminal.ansiWhite": "{{ colors.on_surface.default.hex }}",

    "terminal.ansiBrightBlack": "{{ colors.surface_variant.default.hex }}",
    "terminal.ansiBrightRed": "{{ colors.error.default.hex }}",
    "terminal.ansiBrightGreen": "{{ colors.primary.default.hex }}",
    "terminal.ansiBrightYellow": "{{ colors.secondary.default.hex }}",
    "terminal.ansiBrightBlue": "{{ colors.tertiary.default.hex }}",
    "terminal.ansiBrightMagenta": "{{ colors.primary_container.default.hex }}",
    "terminal.ansiBrightCyan": "{{ colors.tertiary_container.default.hex }}",
    "terminal.ansiBrightWhite": "#ffffff",

    "editor.background": "{{colors.surface.default.hex}}",
    "editor.foreground": "{{colors.on_surface.default.hex}}",

    "editorLineNumber.foreground": "{{colors.outline_variant.default.hex}}",
    "editorLineNumber.activeForeground": "{{colors.on_surface.default.hex}}",

    "editorCursor.foreground": "{{colors.primary.default.hex}}",

    "statusBar.background": "{{colors.surface_container_low.default.hex}}",
    "statusBar.foreground": "{{colors.on_surface.default.hex}}",

    "panel.background": "{{colors.surface.default.hex}}",
    "panel.border": "{{colors.outline_variant.default.hex}}",

    "titleBar.activeBackground": "{{colors.surface.default.hex}}",
    "titleBar.activeForeground": "{{colors.on_surface.default.hex}}",

    "tab.activeBackground": "{{colors.surface.default.hex}}",
    "tab.inactiveBackground": "{{colors.surface_container.default.hex}}",
    "tab.activeForeground": "{{colors.on_surface.default.hex}}",
    "tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",

    "editorGroupHeader.tabsBackground": "{{colors.surface.default.hex}}",
    "editorGroupHeader.tabsBorder": "{{colors.outline_variant.default.hex}}",

    "editorGroupHeader.tab.activeBackground": "{{colors.surface.default.hex}}",
    "editorGroupHeader.tab.activeForeground": "{{colors.on_surface.default.hex}}",

    "editorGroupHeader.tab.inactiveBackground": "{{colors.surface_container.default.hex}}",
    "editorGroupHeader.tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",

    "editorGroupHeader.tab.unfocusedActiveBackground": "{{colors.surface_container_low.default.hex}}",
    "editorGroupHeader.tab.unfocusedInactiveBackground": "{{colors.surface_container.default.hex}}",

    "activityBarTop.background": "{{colors.surface.default.hex}}",

    "sideBar.background": "{{colors.surface.default.hex}}",
    "sideBar.foreground": "{{colors.on_surface.default.hex}}",
    "sideBar.border": "{{colors.outline_variant.default.hex}}",

    "sideBarTitle.background": "{{colors.surface.default.hex}}",
    "sideBarTitle.foreground": "{{colors.on_surface.default.hex}}",

    "sideBarSectionHeader.background": "{{colors.surface_container.default.hex}}",
    "sideBarSectionHeader.foreground": "{{colors.on_surface.default.hex}}",

    "quickInput.background": "{{colors.surface.default.hex}}",
    "quickInput.foreground": "{{colors.on_surface.default.hex}}",

    "quickInputTitle.background": "{{colors.surface_container.default.hex}}",

    "pickerGroup.background": "{{colors.surface_container.default.hex}}",
    "pickerGroup.border": "{{colors.outline_variant.default.hex}}",

    "quickInputList.focusBackground": "{{colors.primary_container.default.hex}}",
    "quickInputList.focusForeground": "{{colors.on_primary_container.default.hex}}",

    "quickInputList.activeSelectionBackground": "{{colors.primary_container.default.hex}}",
    "quickInputList.activeSelectionForeground": "{{colors.on_primary_container.default.hex}}",

    "quickInputList.inactiveSelectionBackground": "{{colors.surface_container_high.default.hex}}",
    "quickInputList.inactiveSelectionForeground": "{{colors.on_surface_variant.default.hex}}"
  }
}

