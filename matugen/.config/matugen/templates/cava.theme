# Generated by matugen ({{mode}}) — cava colours, bottom → top of each bar.
# Background stays the terminal's (keeps the blur/transparency).
[color]
gradient = 1
gradient_color_1 = '{{colors.primary_container.default.hex}}'
gradient_color_2 = '{{colors.primary.default.hex | lighten: -12.0}}'
gradient_color_3 = '{{colors.primary.default.hex}}'
gradient_color_4 = '{{colors.tertiary.default.hex}}'
gradient_color_5 = '{{colors.tertiary.default.hex | lighten: 10.0}}'
