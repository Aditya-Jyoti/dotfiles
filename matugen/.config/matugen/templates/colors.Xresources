*background: {{colors.surface.default.hex}}
*foreground: {{colors.on_surface.default.hex}}
*cursorColor: {{colors.primary.default.hex}}
*color0:  {{colors.surface_dim.default.hex}}
*color1:  {{colors.red.default.hex}}
*color2:  {{colors.green.default.hex}}
*color3:  {{colors.yellow.default.hex}}
*color4:  {{colors.blue.default.hex}}
*color5:  {{colors.magenta.default.hex}}
*color6:  {{colors.cyan.default.hex}}
*color7:  {{colors.on_surface_variant.default.hex}}
*color8:  {{colors.outline.default.hex}}
*color9:  {{colors.red.default.hex | lighten: 8.0}}
*color10: {{colors.green.default.hex | lighten: 8.0}}
*color11: {{colors.yellow.default.hex | lighten: 8.0}}
*color12: {{colors.blue.default.hex | lighten: 8.0}}
*color13: {{colors.magenta.default.hex | lighten: 8.0}}
*color14: {{colors.cyan.default.hex | lighten: 8.0}}
*color15: {{colors.on_surface.default.hex}}
