#!/usr/bin/env bash
# tmux-session-picker — rofi menu of saved sessions (see save-session).
# Switches to the session, creating it (with its saved commands) if needed.
#
# sessions.conf line:  name|path|description|cmd
#   cmd is empty, a single command, or  split:<left cmd>:<right cmd>

SESSIONS_CONF="$HOME/.config/tmux/sessions/sessions.conf"

menu=$(grep -Ev '^(#|$)' "$SESSIONS_CONF" | awk -F'|' '{ printf "%s  —  %s\n", $1, $3 }')
selected=$(rofi -dmenu -i -p " Session" <<<"$menu") || exit 0
[[ -n $selected ]] || exit 0

name=${selected%%  —  *}
IFS='|' read -r _ path _ cmd < <(grep "^$name|" "$SESSIONS_CONF")
path=${path/#\~/$HOME}

if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$path"

    if [[ $cmd == split:* ]]; then
        rest=${cmd#split:}
        left=${rest%%:*}
        right=${rest#*:}

        tmux split-window -t "$name" -h -c "$path"
        [[ -n $left ]]  && tmux send-keys -t "$name".1 "$left" Enter
        [[ -n $right ]] && tmux send-keys -t "$name".2 "$right" Enter
        tmux select-pane -t "$name".2
    elif [[ -n $cmd ]]; then
        tmux send-keys -t "$name" "$cmd" Enter
    fi
fi

# Inside tmux or with a client attached: switch it. Otherwise open a terminal.
if [[ -n ${TMUX:-} ]] || [[ -n $(tmux list-clients 2>/dev/null) ]]; then
    tmux switch-client -t "$name"
else
    setsid -f term -e tmux attach -t "$name" >/dev/null 2>&1
fi
