#!/usr/bin/env bash
# save-session — save the current tmux window as a named session for
# tmux-session-picker (bound to prefix + S in tmux.conf).
# Records the path and what is running in panes 1 and 2 (shells are left blank).

SESSIONS_CONF="$HOME/.config/tmux/sessions/sessions.conf"

pane_count=$(tmux list-panes | wc -l)
path=$(tmux display-message -p -t 1 '#{pane_current_path}')

pane_cmd() {
    local c
    c=$(tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null)
    [[ $c =~ ^(bash|zsh|fish|sh)$ ]] && c=""
    printf '%s' "$c"
}

if (( pane_count >= 2 )); then
    cmd="split:$(pane_cmd 1):$(pane_cmd 2)"
else
    cmd=$(pane_cmd 1)
fi

name=$(rofi -dmenu -p " Session name" </dev/null) || exit 0
[[ -n $name ]] || exit 0

desc=$(rofi -dmenu -p " Description" </dev/null)
desc=${desc:-no description}

if grep -q "^$name|" "$SESSIONS_CONF"; then
    confirm=$(printf 'Yes\nNo' | rofi -dmenu -p " '$name' exists, overwrite?")
    [[ $confirm == Yes ]] || exit 0
    sed -i "/^$name|/d" "$SESSIONS_CONF"
fi

echo "$name|$path|$desc|$cmd" >> "$SESSIONS_CONF"
tmux display-message "Saved session: $name → $path ${cmd:+[$cmd]}"
