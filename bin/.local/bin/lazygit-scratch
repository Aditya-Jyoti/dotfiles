#!/usr/bin/env bash
# lazygit-scratch — toggle a floating lazygit for the repo you're working in.
#
# The repo is taken from the focused tmux pane (or the focused window's cwd).
# Hidden + same repo -> show; visible -> hide; different repo -> restart there.
# Bound to super + g; the floating rule lives in bspwmrc.

CLASS="lazygit-scratch"
SESSION="lazygit-scratch"

launch() {
    local root=$1 win

    tmux has-session -t "$SESSION" 2>/dev/null ||
        tmux new-session -d -s "$SESSION" -c "$root" \; send-keys -t "$SESSION" lazygit Enter

    alacritty --class "$CLASS" -e tmux attach -t "$SESSION" &

    # Wait (up to 2s) for the window, then make sure it floats
    for _ in {1..20}; do
        win=$(xdotool search --class "$CLASS" 2>/dev/null | head -1)
        [[ -n $win ]] && break
        sleep 0.1
    done
    [[ -n $win ]] && bspc node "$win" --state floating
}

# Working directory of whatever the user is looking at
current_dir() {
    local pane_pid child pid win_pid

    pane_pid=$(tmux display-message -p '#{pane_pid}' 2>/dev/null)
    if [[ -n $pane_pid ]]; then
        child=$(pgrep -P "$pane_pid" 2>/dev/null | tail -1)
        pid=${child:-$pane_pid}
        readlink "/proc/$pid/cwd" 2>/dev/null && return
    fi

    win_pid=$(xprop -id "$(xdotool getactivewindow)" _NET_WM_PID 2>/dev/null | awk '{ print $3 }')
    [[ -n $win_pid ]] && readlink "/proc/$win_pid/cwd" 2>/dev/null && return

    echo "$HOME"
}

cwd=$(current_dir)
repo=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)

if [[ -z $repo ]]; then
    notify-send -i dialog-warning "lazygit" "Not inside a git repo ($cwd)"
    exit 1
fi

win=$(xdotool search --class "$CLASS" 2>/dev/null | head -1)

if [[ -z $win ]]; then
    launch "$repo"
elif ! bspc query -N -n "$win.hidden" >/dev/null 2>&1; then
    bspc node "$win" --flag hidden=on                       # visible -> hide
else
    open_path=$(tmux display-message -t "$SESSION" -p '#{pane_current_path}' 2>/dev/null)
    open_repo=$(git -C "$open_path" rev-parse --show-toplevel 2>/dev/null)

    if [[ $open_repo == "$repo" ]]; then
        bspc node "$win" --flag hidden=off --focus          # same repo -> show
    else
        xdotool windowclose "$win"                          # other repo -> restart
        tmux kill-session -t "$SESSION" 2>/dev/null
        sleep 0.2
        launch "$repo"
    fi
fi
