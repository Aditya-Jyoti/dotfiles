#!/usr/bin/env bash
# setwall — set wallpaper + regenerate matugen colours everywhere
#
#   setwall                 pick from $WALLDIR with rofi
#   setwall <image>         use a specific image
#   setwall --random        random image from $WALLDIR
#   setwall --restore       re-apply the last wallpaper (used at login)
#   setwall --mode dark|light|toggle   switch mode, keep wallpaper
#   setwall --theme [name|auto]        fixed theme for the current wallpaper (rofi if no name)
#
# A wallpaper's theme is remembered in ~/.config/matugen/wallpaper-themes and comes
# back whenever that wallpaper is picked. Themes live in ~/.config/matugen/themes.toml.
#
# Env: WALLDIR (default ~/.wallpapers), MATUGEN_TYPE (default scheme-vibrant),
#      MATUGEN_PREFER (default value; also darkness|lightness|saturation|less-saturation)

set -euo pipefail

WALLDIR="${WALLDIR:-$HOME/.wallpapers}"
CACHE="$HOME/.cache/matugen"
SCRIPTS="$(dirname "$(realpath "$0")")"
mkdir -p "$CACHE"

WALL_THEMES="$HOME/.config/matugen/wallpaper-themes"
mode=$(cat "$CACHE/mode" 2>/dev/null || echo dark)
current=$(cat "$CACHE/current_wallpaper" 2>/dev/null || true)

# Fixed theme assigned to a wallpaper (empty = use wallpaper colours)
theme_for() {
    awk -F' *= *' -v w="$(basename "$1")" '$1 == w { print $2 }' "$WALL_THEMES" 2>/dev/null
}

# Assign (or with "auto", clear) the theme for a wallpaper
set_theme_for() {
    local wall theme=$2
    wall=$(basename "$1")
    touch "$WALL_THEMES"
    sed -i "/^$(printf '%s' "$wall" | sed 's/[][\\.*^$/]/\\&/g') *=/d" "$WALL_THEMES"
    [ "$theme" = auto ] || echo "$wall = $theme" >> "$WALL_THEMES"
}

list_walls() {
    find -L "$WALLDIR" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) "$@"
}

# Square, centre-cropped thumbnail (cached; full-size images make rofi slow).
# Square because rofi draws icons in a square box: anything else gets bars around it.
thumb() {
    local key file
    key=$(stat -c '%n %Y' "$1" | md5sum | cut -c1-16)
    file="$HOME/.cache/setwall/thumbs/$key.jpg"
    [ -f "$file" ] || {
        mkdir -p "${file%/*}"
        ffmpeg -loglevel error -y -i "$1" -frames:v 1 \
            -vf 'scale=400:400:force_original_aspect_ratio=increase,crop=400:400' "$file"
    }
    echo "$file"
}

# Rofi grid of thumbnails only; the hidden text (file name) still works for type-to-filter
pick_wall() {
    local walls index w selected=0
    mapfile -t walls < <(list_walls | sort)
    [ ${#walls[@]} -gt 0 ] || { echo "setwall: no images in $WALLDIR" >&2; return 1; }
    for index in "${!walls[@]}"; do [ "${walls[index]}" = "$current" ] && selected=$index; done
    local rows=$(( (${#walls[@]} + 2) / 3 )); [ $rows -le 3 ] || rows=3
    index=$(for w in "${walls[@]}"; do
                printf '%s\0icon\x1f%s\n' "${w#"$WALLDIR"/}" "$(thumb "$w")"
            done |
        rofi -dmenu -i -show-icons -format i -p "󰸉 " \
             -selected-row "$selected" \
             -theme-str 'window { width: 1000px; height: 0; }' \
             -theme-str "listview { columns: 3; lines: $rows; spacing: 12px; flow: horizontal; }" \
             -theme-str 'element { children: [element-icon]; padding: 5px; border-radius: 10px; }' \
             -theme-str 'element normal.normal, element alternate.normal { background-color: transparent; }' \
             -theme-str 'element-icon { size: 300px; }') || return 1
    [ -n "$index" ] && echo "${walls[$index]}"
}

case "${1:-}" in
    "")
        img=$(pick_wall) || exit 0
        ;;
    --random)
        img=$(list_walls | grep -vxF "$current" | shuf -n1)
        ;;
    --restore)
        img="$current"
        ;;
    --mode)
        case "${2:-toggle}" in
            toggle) [ "$mode" = dark ] && mode=light || mode=dark ;;
            dark | light) mode="$2" ;;
            *) echo "usage: setwall --mode dark|light|toggle" >&2; exit 1 ;;
        esac
        echo "$mode" > "$CACHE/mode"
        img="$current"
        ;;
    --theme)
        theme=${2:-}
        if [ -z "$theme" ]; then
            choice=$({ echo "auto  (wallpaper colours)"; matugen-theme --list; } |
                rofi -dmenu -i -p "󰏘 theme") || exit 0
            theme=${choice%% *}
        fi
        [ "$theme" = auto ] || matugen-theme --list | grep -qx "$theme" ||
            { echo "setwall: unknown theme '$theme'" >&2; exit 1; }
        set_theme_for "$current" "$theme"
        img="$current"
        ;;
    -h | --help)
        sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        img=$(realpath "$1")
        ;;
esac

[ -n "${img:-}" ] && [ -f "$img" ] || { echo "setwall: no wallpaper found (${img:-none})" >&2; exit 1; }

feh --no-fehbg --bg-fill "$img"

# --restore only needs the wallpaper; colours are already cached
if [ "${1:-}" = --restore ] && [ -f "$CACHE/colors.sh" ]; then
    exit 0
fi

theme=$(theme_for "$img")
if [ -n "$theme" ]; then
    matugen-theme "$theme" "$mode" > "$CACHE/theme.json"
    matugen json "$CACHE/theme.json" -m "$mode" -q
    label="$theme $mode"
else
    # "value" follows the image's dominant hue; "saturation" chases small vivid accents
    matugen image "$img" -m "$mode" -t "${MATUGEN_TYPE:-scheme-vibrant}" --prefer "${MATUGEN_PREFER:-value}" -q
    label="wallpaper · $mode"
fi
echo "$img" > "$CACHE/current_wallpaper"

"$SCRIPTS/theme-reload"
("$SCRIPTS/screenlock" --render >/dev/null 2>&1 &)   # pre-render lock background
notify-send -a setwall -i "$img" "Theme updated" "$(basename "$img") · $label" 2>/dev/null || true
