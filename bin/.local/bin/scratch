#!/usr/bin/env bash
# scratch — the scratchpad: one floating window holding a persistent zellij
# session ("scratchpad"). It floats above everything, follows you to any
# workspace/monitor, and keeps running while hidden (music keeps playing).
#
#   scratch              toggle (super + \)
#   scratch open <cmd…>  show the scratchpad and focus <cmd>'s pane, starting
#                        it in a new pane if it isn't running (super + e = yazi)
#   scratch add <cmd…>   always open <cmd> as a new pane, without showing it
#
# Inside it's normal zellij: Alt n new pane, Alt t new tab, Alt z fullscreen a
# pane, Alt w floating panes, Alt q close. Closing the window only detaches —
# everything in it stays alive and comes back on the next toggle.

CLASS=Scratchpad
SESSION=scratchpad
SCALE=80   # % of the monitor

win() { xdotool search --classname "^$CLASS$" 2>/dev/null | head -n1; }

# Size + centre the window on the focused monitor
place() {
    local id=$1 mx my mw mh w h
    read -r mx my mw mh < <(bspc query -T -m focused |
        jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')
    w=$(( mw * SCALE / 100 )) h=$(( mh * SCALE / 100 ))
    xdotool windowsize "$id" "$w" "$h" windowmove "$id" $(( mx + (mw - w) / 2 )) $(( my + (mh - h) / 2 ))
}

# Open the window (attaching to / creating the session), wait for it, size it
launch() {
    local first=() id
    # first ever start: spotatui in the first pane (when installed)
    [[ -z $(zellij ls -n 2>/dev/null | awk -v s="$SESSION" '$1 == s && !/EXITED/') ]] &&
        command -v spotatui >/dev/null && first=(-- spotatui)
    bspc rule -a "$CLASS" -o state=floating sticky=on layer=above
    # term = alacritty with the right font size for this monitor
    setsid -f term --class "$CLASS" --title Scratchpad \
        -e zellij attach -c "$SESSION" "${first[@]}" >/dev/null 2>&1
    for _ in $(seq 30); do
        id=$(win)
        [[ -n $id ]] && { place "$id"; return; }
        sleep 0.1
    done
}

# Make the window visible and focused on this monitor (never hides it)
show() {
    local id; id=$(win)
    if [[ -z $id ]]; then launch; return; fi
    if [[ -n $(bspc query -N -n "$id.hidden" 2>/dev/null) ]]; then
        bspc node "$id" --to-monitor focused --flag hidden=off --flag sticky=on --layer above
        place "$id"
    else
        bspc node "$id" --to-monitor focused
    fi
    bspc node "$id" --focus
}

case ${1:-} in
    add)
        shift
        [[ $# -gt 0 ]] || { echo "usage: scratch add <command…>" >&2; exit 2; }
        zellij attach -b "$SESSION" >/dev/null 2>&1
        exec zellij --session "$SESSION" run --cwd "$HOME" -- "$@"
        ;;
    open)
        shift
        [[ $# -gt 0 ]] || { echo "usage: scratch open <command…>" >&2; exit 2; }
        zellij attach -b "$SESSION" >/dev/null 2>&1
        # a live pane already running this program? (started as its command,
        # or typed into a shell pane)
        pane=$(zellij --session "$SESSION" action list-panes -c -t -j 2>/dev/null | jq -r --arg c "$1" '
            [ .[] | select((.is_plugin | not) and (.exited | not))
                  | select([.terminal_command, .running_command][]
                           | strings | split(" ")[0] | split("/")[-1] == $c) ][0]
            | if . then "terminal_\(.id) \(.tab_position)" else empty end')
        if [[ -n $pane ]]; then
            zellij --session "$SESSION" action go-to-tab $(( ${pane#* } + 1 ))
            zellij --session "$SESSION" action focus-pane-id "${pane% *}"
        else
            zellij --session "$SESSION" run --cwd "$HOME" -- "$@" >/dev/null
        fi
        show
        ;;
    "")
        id=$(win)
        [[ -z $id ]] && { launch; exit 0; }
        hidden=$(bspc query -N -n "$id.hidden" 2>/dev/null)
        focused=$(bspc query -N -n focused 2>/dev/null)
        if [[ -n $hidden ]]; then
            show
        elif [[ $((id)) -eq $((focused)) ]]; then
            bspc node "$id" --flag hidden=on
        else
            # visible but behind focus → bring it forward instead of hiding
            bspc node "$id" --to-monitor focused --focus
        fi
        ;;
    *)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
