#!/usr/bin/env bash
# bspscratch — i3-style scratchpad for bspwm (after ayan7744/bspscratchpad).
#
#   bspscratch move    focused window into the scratchpad (floating, sticky,
#                      hidden) — or, if it's already there, back to a normal
#                      tiled window                               super + shift + \
#   bspscratch toggle  show every scratchpad window on this workspace, or
#                      hide them all if any is showing             super + \
#                      (the rest of the screen is blurred while they're up)
#   bspscratch sync    drop that blur if no scratchpad window is visible
#
# Members: windows you moved in, plus the dedicated scratchpad apps (classes
# in DEFAULT_CLASSES: the yazi explorer and spotatui), which always belong;
# `toggle` starts whichever of those two isn't running (hidden) before showing.
# State lives in $XDG_RUNTIME_DIR, so it's cleared on logout.

DEFAULT_CLASSES='^(Explorer|Spotatui)$'
STATE=${XDG_RUNTIME_DIR:-/tmp}/bspscratch
IDS=$STATE/ids
mkdir -p "$STATE"; touch "$IDS"

dec() { printf '%d\n' "$1"; }                       # 0x… (bspc) → decimal (xdotool)
alive() { bspc query -N -n "$1" >/dev/null 2>&1; }

# Drop windows that were closed since
prune() {
    local id kept=()
    while read -r id; do [[ -n $id ]] && alive "$id" && kept+=("$id"); done <"$IDS"
    printf '%s\n' "${kept[@]}" | sed '/^$/d' >"$IDS"
}

members() {
    { cat "$IDS"; xdotool search --classname "$DEFAULT_CLASSES" 2>/dev/null; } |
        while read -r id; do [[ -n $id ]] && dec "$id"; done | awk '!seen[$0]++'
}

is_member() { members | grep -qx "$(dec "$1")"; }

# Backdrop: a full-monitor, see-through window just under the scratchpad
# windows; picom blurs whatever is behind it (rule for class ScratchDim in
# picom.conf), so the rest of the desktop goes soft while the scratchpad is up.
dim_on() {
    local mx my mw mh img=$STATE/dim.png
    dim_off
    [[ -f $img ]] || magick -size 8x8 xc:black "$img"
    read -r mx my mw mh < <(bspc query -T -m focused |
        jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')
    bspc rule -a ScratchDim -o state=floating sticky=on layer=normal focus=off border=off \
        rectangle="${mw}x${mh}+${mx}+${my}"
    setsid -f feh --class ScratchDim --title ScratchDim --borderless --no-menus \
        --zoom fill --geometry "${mw}x${mh}+${mx}+${my}" "$img" >/dev/null 2>&1
}
dim_off() { pkill -f 'feh --class ScratchDim' 2>/dev/null; }

# Drop the backdrop once no scratchpad window is visible any more
# (e.g. after hiding them one by one with super + e / super + m)
dim_sync() {
    local id
    for id in $(members); do
        [[ -z $(bspc query -N -n "$(printf '0x%08X' "$id").hidden" 2>/dev/null) ]] && return
    done
    dim_off
}

# Start the dedicated scratchpad apps that aren't running (e.g. after a
# reboot), hidden via a one-shot rule, and wait until bspwm manages them, so
# `toggle` lays them out with the rest instead of them popping up on their own.
ensure_defaults() {
    local class id started=()
    local -A cmd=(
        [Explorer]='term --class Explorer --title Explorer -e yazi'
        [Spotatui]='term --class Spotatui --title spotatui -e spotatui'
    )
    for class in Explorer Spotatui; do
        xdotool search --classname "^$class\$" >/dev/null 2>&1 && continue
        # spotatui allows one copy: skip it if it runs in some other terminal
        [[ $class == Spotatui ]] && pgrep -x spotatui >/dev/null && continue
        bspc rule -a "$class" -o hidden=on
        setsid -f sh -c "${cmd[$class]}" >/dev/null 2>&1
        started+=("$class")
    done
    for class in "${started[@]}"; do
        for _ in $(seq 60); do   # up to 3s
            id=$(xdotool search --classname "^$class\$" 2>/dev/null | head -1)
            [[ -n $id ]] && bspc query -N -n "$(printf '0x%08X' "$id")" >/dev/null 2>&1 && break
            sleep 0.05
        done
    done
}

show() {
    bspc node "$1" --to-monitor focused --flag hidden=off --flag sticky=on --state floating --layer above
    bspc node "$1" --focus
}

case $1 in
    move)
        prune
        f=$(bspc query -N -n focused) || exit 0
        if grep -qx "$(dec "$f")" "$IDS"; then
            grep -vx "$(dec "$f")" "$IDS" >"$IDS.tmp"; mv "$IDS.tmp" "$IDS"
            bspc node "$f" --flag sticky=off --layer normal --state tiled
        else
            dec "$f" >>"$IDS"
            bspc node "$f" --state floating --flag sticky=on --layer above --flag hidden=on
        fi
        ;;
    toggle)
        prune
        hex() { printf '0x%08X' "$1"; }
        mapfile -t list < <(members)
        visible=0
        for id in "${list[@]}"; do
            [[ -z $(bspc query -N -n "$(hex "$id").hidden" 2>/dev/null) ]] && visible=1
        done
        # about to show: make sure the explorer and spotatui exist first
        if (( ! visible )); then
            ensure_defaults
            mapfile -t list < <(members)
        fi
        (( ${#list[@]} )) || { dunstify -a scratchpad -u low "Scratchpad is empty" "super + shift + \\ moves a window in"; exit 0; }
        if (( visible )); then
            for id in "${list[@]}"; do bspc node "$(hex "$id")" --flag hidden=on; done
            dim_off
            exit 0
        fi
        # 1. blur first: start the backdrop and wait until it's on screen
        dim_on
        for _ in $(seq 20); do
            xdotool search --class '^ScratchDim$' >/dev/null 2>&1 && break
            sleep 0.05
        done
        # 2. size + place the windows while still hidden (grid, max 3 per row,
        #    over 90% x 80% of the monitor), so nothing jumps after appearing
        read -r mx my mw mh < <(bspc query -T -m focused |
            jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')
        n=${#list[@]} gap=12
        cols=$(( n < 3 ? n : 3 )) rows=$(( (n + 2) / 3 ))
        aw=$(( mw * 90 / 100 )) ah=$(( mh * 80 / 100 ))
        ax=$(( mx + (mw - aw) / 2 )) ay=$(( my + (mh - ah) / 2 ))
        w=$(( (aw - gap * (cols - 1)) / cols )) h=$(( (ah - gap * (rows - 1)) / rows ))
        for i in "${!list[@]}"; do
            bspc node "$(hex "${list[i]}")" --to-monitor focused --flag sticky=on --state floating --layer above
            c=$(( i % cols )) r=$(( i / cols ))
            xdotool windowsize "${list[i]}" "$w" "$h" \
                windowmove "${list[i]}" $(( ax + c * (w + gap) )) $(( ay + r * (h + gap) ))
        done
        # 3. then show them, focusing the last one
        for id in "${list[@]}"; do bspc node "$(hex "$id")" --flag hidden=off; done
        bspc node "$(hex "${list[-1]}")" --focus
        ;;
    sync)
        dim_sync
        ;;
    *)
        sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac
