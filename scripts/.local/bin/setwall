#!/usr/bin/env bash
set -e

WALL="$1"
CACHE_DIR="$HOME/.cache/matugen"
WALL_CACHE="$CACHE_DIR/current_wallpaper"

[ -z "$WALL" ] && {
  echo "Usage: setwall <image>"
  exit 1
}

mkdir -p "$CACHE_DIR"

# ----------------------------------------
# 1. Store wallpaper path
# ----------------------------------------
echo "$WALL" > "$WALL_CACHE"

# ----------------------------------------
# 2. Set wallpaper
# ----------------------------------------
feh --bg-scale "$WALL"

# ----------------------------------------
# 3. Generate theme via matugen (THIS is key)
# ----------------------------------------

matugen image "$WALL" --mode dark --source-color-index 0

# ----------------------------------------
# 4. Reload UI components (optional but recommended)
# ----------------------------------------

# reload polybar
killall -q polybar
"$HOME/.config/polybar/launch.sh" &

# reload dunst (optional)
killall -q dunst
dunst &
