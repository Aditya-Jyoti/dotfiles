#!/usr/bin/env bash

colors=(
  primary "#ffb68b"
  primary-fixed "#ffdbc8"
  primary-fixed-dim "#ffb68b"
  on-primary "#522300"
  primary-container "#6f3811"
  on-primary-container "#ffdbc8"

  secondary "#e5bfaa"
  secondary-container "#5c4131"

  tertiary "#ccc992"
  tertiary-container "#4a491e"

  error "#ffb4ab"
  error-container "#93000a"

  surface "#1a120d"
  surface-container "#271e19"
  surface-container-high "#312823"
  surface-container-highest "#3d332d"

  on-surface "#f0dfd7"
  on-surface-variant "#d7c2b8"
  outline "#9f8d84"
)

for ((i=0; i<${#colors[@]}; i+=2)); do
  name="${colors[i]}"
  hex="${colors[i+1]}"

  r=$((16#${hex:1:2}))
  g=$((16#${hex:3:2}))
  b=$((16#${hex:5:2}))

  printf "%-30s \e[48;2;%d;%d;%dm  %-10s  \e[0m\n" \
    "$name" "$r" "$g" "$b" "$hex"
done

