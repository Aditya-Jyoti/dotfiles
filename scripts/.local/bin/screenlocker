#!/bin/bash
# Sleeping cause the poermenu has to disappear before it takes the screenshot for blurring
# sleep 1

# Path to matugen colors.json
MATUGEN_COLORS="$HOME/.cache/matugen/colors.json"

# Check if jq is installed
if ! command -v jq &> /dev/null; then
    echo "Error: jq is required to parse matugen colors"
    exit 1
fi

# Check if colors.json exists
if [ ! -f "$MATUGEN_COLORS" ]; then
    echo "Error: Matugen colors not found at $MATUGEN_COLORS"
    exit 1
fi

# Extract colors from matugen JSON (using dark mode colors)
MODE=$(jq -r '.mode' "$MATUGEN_COLORS")

# Function to get color based on mode
get_color() {
    jq -r ".colors.$1.$MODE" "$MATUGEN_COLORS"
}

# Map matugen colors to i3lock variables
BLANK="00000000"
CLEAR="#00000000"
DEFAULT="$(get_color 'on_surface')"           # Text color
FOREGROUND="$(get_color 'on_surface')"        # Text color
BACKGROUND="$(get_color 'surface')9F"         # Surface with transparency
WRONG="$(get_color 'error')"                  # Error color
VERIFYING="$(get_color 'tertiary')"           # Tertiary for verifying
HIGHLIGHT="$(get_color 'primary')"            # Primary for highlights

i3lockmore \
    --ignore-empty-password \
    --fill \
    \
    --radius 200 \
    --ring-width 12 \
    \
    --insidever-color=$BACKGROUND \
    --ringver-color=$VERIFYING \
    \
    --insidewrong-color=$BACKGROUND \
    --ringwrong-color=$WRONG \
    \
    --inside-color=$BACKGROUND \
    --ring-color=$DEFAULT \
    --line-color=$BLANK \
    --separator-color=$DEFAULT \
    \
    --verif-color=$FOREGROUND \
    --wrong-color=$FOREGROUND \
    --time-color=$FOREGROUND \
    --date-color=$FOREGROUND \
    --layout-color=$FOREGROUND \
    --keyhl-color=$HIGHLIGHT \
    --bshl-color=$WRONG \
    \
    --screen 1 \
    --blur 8 \
    --clock \
    \
    --time-str="%H:%M:%S" \
    --date-str="%A, %Y-%m-%d" \
    --time-pos="960:555" \
    --time-size=75 \
    --date-size=20 \
    \
    --verif-text="Verifying" \
    --wrong-text="Incorrect" \
    --noinput-text="Empty" \
    \
    --indicator
