#!/bin/bash

MATUGEN_COLORS="$HOME/.cache/matugen/colors.sh"

if [ ! -f "$MATUGEN_COLORS" ]; then
    echo "Error: Matugen colors not found at $MATUGEN_COLORS"
    exit 1
fi

# Source the colors
source "$MATUGEN_COLORS"

# Strip # and map semantic names
strip() { echo "${1#\#}"; }

DEFAULT="$(strip "$color7")"       # on_surface
FOREGROUND="$(strip "$color7")"    # on_surface
BACKGROUND="$(strip "$color0")9F"  # surface with transparency
WRONG="$(strip "$color1")"         # error
VERIFYING="$(strip "$color2")"     # tertiary
HIGHLIGHT="$(strip "$color4")"     # primary
BLANK="00000000"

echo "Colors loaded: DEFAULT=$DEFAULT WRONG=$WRONG HIGHLIGHT=$HIGHLIGHT"

i3lockmore \
    --ignore-empty-password \
    --fill \
    \
    --radius 200 \
    --ring-width 12 \
    \
    --insidever-color="$BACKGROUND" \
    --ringver-color="$VERIFYING" \
    \
    --insidewrong-color="$BACKGROUND" \
    --ringwrong-color="$WRONG" \
    \
    --inside-color="$BACKGROUND" \
    --ring-color="$DEFAULT" \
    --line-color="$BLANK" \
    --separator-color="$DEFAULT" \
    \
    --verif-color="$FOREGROUND" \
    --wrong-color="$FOREGROUND" \
    --time-color="$FOREGROUND" \
    --date-color="$FOREGROUND" \
    --layout-color="$FOREGROUND" \
    --keyhl-color="$HIGHLIGHT" \
    --bshl-color="$WRONG" \
    \
    --screen 1 \
    --blur 8 \
    --clock \
    \
    --time-str="%H:%M:%S" \
    --date-str="%A, %Y-%m-%d" \
    --time-pos="960:555" \
    --time-size=75 \
    --date-size=20 \
    \
    --verif-text="Verifying" \
    --wrong-text="Incorrect" \
    --noinput-text="Empty" \
    \
    --indicator
