# Colours live in dunstrc.d/50-matugen.conf (generated by matugen)

[global]
    origin = top-right
    offset = (20, 50)
    width = (250, 380)
    notification_limit = 5
    gap_size = 6
    separator_height = 1
    padding = 10
    horizontal_padding = 14
    corner_radius = 10
    progress_bar_corner_radius = 4

    # Frame
    frame_width = 2
    frame_color = "#4a4458"

    # Text
    font = FiraCode Nerd Font 12px
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    ellipsize = end
    icon_position = left
    max_icon_size = 48

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action

    # Actions
    show_indicators = false

[urgency_low]
    timeout = 3
    background = "#161217"
    foreground = "#e8e0e8"

[urgency_normal]
    timeout = 6
    background = "#161217"
    foreground = "#e8e0e8"

[urgency_critical]
    timeout = 0
    background = "#161217"
    foreground = "#e8e0e8"
