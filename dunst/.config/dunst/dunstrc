[global]
    offset = (20, 60)
    separator_height = 1

	# Frame
    frame_width = 2
    frame_color = "#32302f"

	# Text
    font = FiraCode Nerd Font 12px
    alignment = center

	# Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action

	# Actions
	show_indicators = false

	transparency = 25

[urgency_low]
    timeout = 3
    frame_color = "#deb8f7"
    background = "#161217"
    foreground = "#e8e0e8"

[urgency_normal]
    timeout = 6
    frame_color = "#deb8f7"
    background = "#161217"
    foreground = "#e8e0e8"

[urgency_critical]
    timeout = 0
    frame_color = "#deb8f7"
    background = "#161217"
    foreground = "#e8e0e8"
