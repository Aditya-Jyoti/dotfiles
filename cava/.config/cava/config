## cava — audio visualizer. Colours come from matugen (themes/matugen, follows the wallpaper).
## Run `cava` in any terminal; it sleeps when nothing is playing.

[general]
framerate    = 60
autosens     = 1
bars         = 0          # 0 = fit the terminal width
bar_width    = 2
bar_spacing  = 1
# stop drawing after 3 s of silence (no CPU while idle)
sleep_timer  = 3
lower_cutoff_freq  = 40
higher_cutoff_freq = 12000

[input]
method = pipewire
source = auto
# don't show up as an app in pavucontrol / notifications
virtual = 1

[output]
method      = noncurses
orientation = bottom
# stereo mirrors the channels: bass in the middle, highs at the edges
channels    = stereo
show_idle_bar_heads = 0
disable_blanking    = 0

[color]
theme = 'matugen'

[smoothing]
# soft "monstercat" shoulders between bars, then gentle falloff
monstercat      = 1
waves           = 0
noise_reduction = 82
