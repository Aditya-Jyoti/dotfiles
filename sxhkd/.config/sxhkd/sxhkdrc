#! /bin/sh

#################################################
# ROFI / LAUNCHERS
#################################################

# App launcher
alt + space
    rofi -show drun

# Clipboard (greenclip) — with image thumbnails
super + o
    clipboard

# Calendar popup (same as clicking the clock)
super + c
    calendar-popup

# Calculator
super + p
    rofi-calculator

# Wallpaper picker -> regenerates matugen colours everywhere
super + w
    setwall

# Toggle light / dark colours (same wallpaper)
super + shift + w
    setwall --mode toggle

# Display layout: extend / mirror / one screen
super + shift + d
    displays

# Fixed theme for this wallpaper (gruvbox, nord, …) or back to wallpaper colours
super + alt + w
    setwall --theme


#################################################
# SCRATCHPADS / APPLICATIONS
#################################################

# Control center: Wi-Fi, Bluetooth, volume, CPU, RAM, battery popout
super + a
    control-center

# Scratchpad (i3-style): any window can live there, floating above everything
# on every workspace. super + \ shows all of them at once / hides them all,
# super + shift + \ moves the focused window in (or back out to tiled)
super + backslash
    bspscratch toggle

super + shift + backslash
    bspscratch move

# Scratchpad apps: toggle their own window (they're always in the scratchpad)
# (spotatui allows one copy: if it's already running in some other terminal, say so)
super + m
    if pgrep -x spotatui >/dev/null && ! xdotool search --classname '^Spotatui$' >/dev/null; then \
        dunstify -a spotatui -u low "spotatui is already running" "in another terminal; quit it there first"; \
    else \
        scratchpad Spotatui 'term --class Spotatui --title spotatui -e spotatui'; \
    fi

# File explorer: yazi, a scratchpad app
super + e
    scratchpad Explorer 'term --class Explorer --title Explorer -e yazi'

super + n 
    scratchpad notes.omrin.in "brave --app=https://notes.omrin.in --class=AffineScratchpad"

super + l 
    workspace-switcher

# Spotify
{KP_7,KP_Home}
    scratchpad Spotify 'spotify'

# Obsidian
{KP_9,KP_Prior}
    scratchpad Obsidian 'obsidian'

#################################################
# SYSTEM / UTILITIES
#################################################

# Screenshot
Print
    shot

super + shift + s
    flameshot gui

# Gnome screenshot (selection / UI)
{KP_1,KP_End}
    gnome-screenshot


#################################################
# LOCK / POWER
#################################################

super + Home
    screenlock

super + Delete
    screenlock


#################################################
# TERMINAL
#################################################

super + Return
    term

super + grave
    term

#################################################
# BSPWM — DESKTOP & WINDOW MANAGEMENT
#################################################

# Move window to desktop (and follow)
super + shift + {1-9,0}
    id=$(bspc query -N -n); bspc node -d {1-9,10}; bspc node -f ${id}

# Switch desktops
super + {1-9}
    bspc desktop -f {1-9}

# Close focused window
super + shift + q
    bspc node -c

# Reload BSPWM
super + shift + r
    bspc wm -r

#################################################
# BSPWM — FOCUS & MOVE
#################################################

# Vim-style focus / swap
super + {_,shift} + {h,l,k,j}
    bspc node -{f,s} {west,east,north,south}

# Arrow key focus
super + {Left,Right,Up,Down}
    bspc node -f {west,east,north,south}

#################################################
# BSPWM — RESIZE
#################################################

super + shift + {Left,Down,Up,Right}
    bspc node -z { \
        left  -30 0 || bspc node -z right -30 0, \
        bottom 0  30 || bspc node -z top    0  30, \
        top    0 -30 || bspc node -z bottom 0 -30, \
        right  30 0 || bspc node -z left   30 0 \
    }

#################################################
# BSPWM — STATES
#################################################

# Toggle floating
super + space
    bspc node focused -t \~floating

# Toggle pseudo-tiled
super + alt + space
    if [ -z "$(bspc query -N -n focused.pseudo_tiled)" ]; then \
        bspc node focused -t pseudo_tiled; \
    else \
        bspc node focused -t tiled; \
    fi

# Fullscreen / monocle
super + f
    bspc desktop -l next

alt + f
    bspc node -t \~fullscreen

super + shift + f
    pbtoggle

# Focus last closed window
super + Tab
    bspc node last --focus



XF86Audio{Raise,Lower}Volume
    volume-control {up,down}

XF86AudioMute 
    volume-control mute

# Brightness
XF86MonBrightness{Down,Up}
    brightness-control {down,up}

# Keyboard knob: plain = volume (above), super + knob = brightness
# (the AULA F75 doesn't send Fn to the computer, so fn + knob can't be told apart)
super + XF86Audio{Lower,Raise}Volume
    brightness-control {down,up}
