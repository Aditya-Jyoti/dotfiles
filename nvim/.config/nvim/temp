
{
  "editor.fontFamily": "FiraCode Nerd Font, sans",
  "editor.fontLigatures": false,
  "editor.fontWeight": "400",
  "files.autoSave": "afterDelay",
  "editor.wordWrap": "on",
  "terminal.external.windowsExec": "%COMSPEC%",

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,

  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "p"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.focusSideBar"]
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.focusAuxiliaryBar"]
    },
    {
      "before": ["<leader>", "b"],
      "commands": ["workbench.action.focusFirstEditorGroup"]
    },
    {
      "before": ["<leader>", "<enter>"],
      "commands": ["workbench.action.terminal.new"]
    },
    {
      "before": ["<leader>", "\\"],
      "commands": ["workbench.action.toggleAuxiliaryBar"]
    },
    {
      "before": ["H"],
      "after": ["h"]
    },
    {
      "before": ["J"],
      "after": ["j"]
    },
    {
      "before": ["K"],
      "after": ["k"]
    },
    {
      "before": ["L"],
      "after": ["l"]
    },
    {
      "before": ["<Left>"],
      "after": ["<Nop>"]
    },
    {
      "before": ["<Right>"],
      "after": ["<Nop>"]
    },
    {
      "before": ["<Down>"],
      "after": ["<Nop>"]
    },
    {
      "before": ["<Up>"],
      "after": ["<Nop>"]
    },
    {
      "before": ["<C-c>"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["<C-v>"],
      "after": ["\"", "+", "p"]
    },
    {
      "before": ["<Enter>"],
      "after": ["o", "<Esc>"]
    },
    {
      "before": ["<BS>"],
      "after": ["i", "<BS>", "<Esc>"]
    },
    {
      "before": ["<Tab>"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<S-Tab>"],
      "commands": ["editor.action.outdentLines"]
    }
  ],
  "vim.insertModeKeyBindings": [
    {
      "before": ["k", "k"],
      "after": ["<Esc>"]
    },
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    },
    {
      "before": ["<C-c>"],
      "after": ["<Esc>", "\"", "+", "y"]
    },
    {
      "before": ["<C-v>"],
      "after": ["<Esc>", "\"", "+", "p"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": ["<C-c>"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["<C-v>"],
      "after": ["\"", "+", "p"]
    },
    {
      "before": ["<Tab>"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<S-Tab>"],
      "commands": ["editor.action.outdentLines"]
    }
  ],
  "vim.leader": "<Space>",

  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-d>": false,
    "<C-k>": false,
    "<A-t>": false,
    "<C-w>": false
  },

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.lineNumbers": "relative",
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "editor.renderWhitespace": "trailing",
  "python.analysis.typeCheckingMode": "basic",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "cSpell.userWords": [
    "Aditya",
    "adityajyoti",
    "bcms",
    "blit",
    "chipka",
    "colour",
    "colours",
    "curr",
    "documentserver",
    "dotenv",
    "fastapi",
    "httpclient",
    "jsonify",
    "Jyoti",
    "mechatronics",
    "neighbour",
    "neighbours",
    "onlyoffice",
    "pathfind",
    "pcode",
    "pointid",
    "pseu",
    "pseudocode",
    "pyautogui",
    "pydantic",
    "pygame",
    "Reclude",
    "Signup",
    "sqlalchemy",
    "supabase",
    "tilemap",
    "Todos",
    "traefik",
    "Volumns"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "scm.inputFontFamily": "editor",
  "debug.terminal.clearBeforeReusing": true,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "redhat.telemetry.enabled": true,
  "terminal.integrated.fontSize": 12,
  "workbench.startupEditor": "none",
  "svelte.enable-ts-plugin": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "RainbowBrackets.depreciation-notice": false,
  "editor.minimap.enabled": false,
  "workbench.activityBar.location": "bottom",
  "terminal.integrated.persistentSessionScrollback": 100000,
  "terminal.integrated.scrollback": 100000,
  "cSpell.customDictionaries": {
    "custom-dictionary-user": {
      "name": "custom-dictionary-user",
      "path": "~/.cspell/custom-dictionary-user.txt",
      "addWords": true,
      "scope": "user"
    }
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.defaultInterpreterPath": "/home/aditya/Programming/Projects/SecretVIT/.venv",
  "window.menuBarVisibility": "toggle",
  "go.toolsManagement.autoUpdate": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "editor.fontSize": 16,
  "workbench.colorTheme": "Gruvbox Dark Hard",

  "workbench.colorCustomizations": {
    "editor.background": "#1a120d",
    "editor.foreground": "#f0dfd7",

    "editorLineNumber.foreground": "#52443c",
    "editorLineNumber.activeForeground": "#f0dfd7",

    "editorCursor.foreground": "#ffb68b",

    "statusBar.background": "#221a15",
