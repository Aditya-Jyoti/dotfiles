    "quickInputList.activeSelectionBackground": "#6f3811",
    "quickInputList.activeSelectionForeground": "#f0dfd7",

    "quickInputList.inactiveSelectionBackground": "#312823",
    "quickInputList.inactiveSelectionForeground": "#d7c2b8"
  }
}
