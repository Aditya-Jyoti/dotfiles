    "tab.inactiveForeground": "#d7c2b8",

    "editorGroupHeader.tabsBackground": "#1a120d",
    "editorGroupHeader.tabsBorder": "#52443c",

    "editorGroupHeader.tab.activeBackground": "#1a120d",
    "editorGroupHeader.tab.activeForeground": "#f0dfd7",

    "editorGroupHeader.tab.inactiveBackground": "#271e19",
    "editorGroupHeader.tab.inactiveForeground": "#d7c2b8",

    "editorGroupHeader.tab.unfocusedActiveBackground": "#221a15",
    "editorGroupHeader.tab.unfocusedInactiveBackground": "#271e19",

    "activityBarTop.background": "#1a120d",

    "sideBar.background": "#1a120d",
