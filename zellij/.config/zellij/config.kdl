// zellij — minimal, no-prefix setup (same file on the laptop and servers)
//
// Zellij starts LOCKED: every key goes to your programs (nvim, shell, ...),
// except the Alt / Ctrl+Shift shortcuts below, which work all the time.
//
//   Panes      Alt n  new          Ctrl Shift →/↓  split right/down
//              Alt h/j/k/l or Ctrl ←↓↑→  focus (h/l jump tabs at the edge)
//              Alt H/J/K/L or Alt Shift ←↓↑→   resize
//              Alt q  close        Alt z  zoom      Alt w  floating on/off
//   Tabs       Alt t  new          Alt 1-9  go to   Alt , / Alt .  prev/next
//              Alt r  rename tab
//   Scroll     Alt s  scroll mode (j/k, d/u, / search, e open in $EDITOR)
//   Session    Alt o  session manager   Alt d  detach
//
// Ctrl g opens the menu for everything else (the bar shows the hints):
//   p pane · t tab · r resize · m move · s scroll · o session · q quit
// Esc or Ctrl g goes back to locked.

theme "dots"   // defined at the bottom; matugen overrides it on the laptop
default_layout "default"
default_mode "locked"

pane_frames true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

show_startup_tips false
show_release_notes false
mouse_hover_tips false
scroll_buffer_size 20000
// Copying uses OSC 52 → works locally and from inside ssh
copy_on_select true
session_serialization true
// Ask before stepping into zellij-on-the-server inside local zellij
nested_session_handling "ask"

keybinds clear-defaults=true {
    // ── always available (locked included) ────────────────────────
    shared {
        bind "Alt n" { NewPane; }
        bind "Ctrl Shift Right" { NewPane "Right"; }
        bind "Ctrl Shift Down"  { NewPane "Down"; }
        bind "Alt q" { CloseFocus; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }

        bind "Alt h" "Ctrl Left"  { MoveFocusOrTab "Left"; }
        bind "Alt l" "Ctrl Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Ctrl Down"  { MoveFocus "Down"; }
        bind "Alt k" "Ctrl Up"    { MoveFocus "Up"; }

        bind "Alt H" "Alt Shift Left"  { Resize "Increase Left"; }
        bind "Alt L" "Alt Shift Right" { Resize "Increase Right"; }
        bind "Alt J" "Alt Shift Down"  { Resize "Increase Down"; }
        bind "Alt K" "Alt Shift Up"    { Resize "Increase Up"; }

        bind "Alt t" "Ctrl Shift t" { NewTab; }
        bind "Alt ," "Ctrl Shift Tab" { GoToPreviousTab; }
        bind "Alt ." "Ctrl Tab"       { GoToNextTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }

        bind "Alt s" { SwitchToMode "Scroll"; }
        bind "Alt d" { Detach; }
        bind "Alt o" {
            LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "Locked"
        }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // ── the menu: Ctrl g, then one letter ─────────────────────────
    normal {
        bind "p" { SwitchToMode "Pane"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
        bind "q" { Quit; }
    }

    pane {
        bind "h" "Left"  { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down"  { MoveFocus "Down"; }
        bind "k" "Up"    { MoveFocus "Up"; }
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "d" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "Tab" { SwitchFocus; }
    }

    tab {
        bind "h" "Left"  { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Locked"; }
        bind "b" { BreakPane; SwitchToMode "Locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "Locked"; }
        bind "Tab" { ToggleTab; }
    }

    resize {
        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "h" "Left"  { MovePane "Left"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab" { MovePane; }
        bind "," { MoveTab "Left"; }
        bind "." { MoveTab "Right"; }
    }

    scroll {
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }

    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    shared_among "scroll" "search" {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up"   { ScrollUp; }
        bind "d" "PageDown" { HalfPageScrollDown; }
        bind "u" "PageUp"   { HalfPageScrollUp; }
        bind "g" "Home" { ScrollToTop; }
        bind "G" "End"  { ScrollToBottom; SwitchToMode "Locked"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Scroll"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Locked"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Enter" { SwitchToMode "Locked"; }
    }

    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "Locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" { floating true; move_to_focused_tab true; }
            SwitchToMode "Locked"
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "Locked"
        }
    }

    // Esc / Ctrl g always gets you back to locked from any menu
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "Esc" "Ctrl g" { SwitchToMode "Locked"; }
    }
}

plugins {
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    configuration location="zellij:configuration"
}

// Gruvbox fallback for "dots". A theme of the same name in themes/ wins over
// this one, so on the laptop setwall/matugen writes themes/matugen.kdl and the
// colours follow the wallpaper; anywhere else (servers) this is used as-is.
themes {
    dots {
        text_unselected   { base "#ebdbb2"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        text_selected     { base "#ebdbb2"; background "#3c3836"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        ribbon_selected   { base "#1d2021"; background "#fabd2f"; emphasis_0 "#fb4934"; emphasis_1 "#fe8019"; emphasis_2 "#d3869b"; emphasis_3 "#83a598"; }
        ribbon_unselected { base "#a89984"; background "#3c3836"; emphasis_0 "#fb4934"; emphasis_1 "#ebdbb2"; emphasis_2 "#83a598"; emphasis_3 "#d3869b"; }
        table_title           { base "#fabd2f"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        table_cell_selected   { base "#ebdbb2"; background "#3c3836"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        table_cell_unselected { base "#a89984"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        list_selected   { base "#ebdbb2"; background "#3c3836"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        list_unselected { base "#a89984"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#b8bb26"; emphasis_3 "#d3869b"; }
        frame_selected   { base "#fabd2f"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#d3869b"; emphasis_3 "#83a598"; }
        frame_unselected { base "#504945"; background "#1d2021"; emphasis_0 "#fe8019"; emphasis_1 "#8ec07c"; emphasis_2 "#d3869b"; emphasis_3 "#83a598"; }
        frame_highlight  { base "#fe8019"; background "#1d2021"; emphasis_0 "#fb4934"; emphasis_1 "#fe8019"; emphasis_2 "#fe8019"; emphasis_3 "#fe8019"; }
        exit_code_success { base "#b8bb26"; background "#1d2021"; emphasis_0 "#8ec07c"; emphasis_1 "#ebdbb2"; emphasis_2 "#d3869b"; emphasis_3 "#83a598"; }
        exit_code_error   { base "#fb4934"; background "#1d2021"; emphasis_0 "#fabd2f"; emphasis_1 "#ebdbb2"; emphasis_2 "#d3869b"; emphasis_3 "#83a598"; }
        multiplayer_user_colors {
            player_1 "#d3869b"; player_2 "#83a598"; player_3 "#fe8019"; player_4 "#fabd2f"; player_5 "#8ec07c"
            player_6 "#fb4934"; player_7 "#b8bb26"; player_8 "#a89984"; player_9 "#d65d0e"; player_10 "#689d6a"
        }
    }
}
